# Copy to deploy.env (git-ignored) and edit for your Pi. Read by deploy.sh,
# deploy/render-units.sh and scripts/staging_tests.py.

# SSH target (key login recommended: ssh-copy-id pi@raspberrypi.local)
NIDAA_PI=pi@raspberrypi.local

# Linux user the services run as, and the install folder on the Pi.
# Layout: $NIDAA_HOME/app (code + config.json), $NIDAA_HOME/audio (MP3s), $NIDAA_HOME/staging
NIDAA_USER=pi
NIDAA_HOME=/home/pi/nidaa

# Python venv on the Pi that has pychromecast + adhanpy (and the dashboard deps).
NIDAA_VENV=/home/pi/nidaa/venv
